# /etc/systemd/system/iqror-sheets.service — GOOGLE SHEETS'ga avtomatik yozish (platforma -> jadval) doimiy ishlaydi
# O'rnatish (to'liq yo'riqnoma — sheets/README.md):
#   sudo cp migration/deploy/iqror-sheets.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now iqror-sheets
# Shart: /opt/iqror/sheets/config.json (serviceRoleKey, spreadsheetId) va /opt/iqror/sheets/google-key.json — ikkalasi 600,
#   egasi iqror. Sozlanmagan bo'lsa xizmat jim kutadi (har 5 daqiqada qayta tekshiradi), qayta-qayta yiqilmaydi.
[Unit]
Description=Iqror Google Sheets sinxronlash (platforma -> jadval)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/iqror
ExecStart=/usr/bin/node sheets/index.cjs
Restart=always
RestartSec=5
User=iqror
Group=iqror
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
